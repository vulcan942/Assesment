# Copy to .env to override. docker compose reads this file by default.
# Placeholder values only; never put real secrets here.

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:8080

# Product data source (Fake Store today)
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
# Comma-separated product ids shown as featured on the home page, in this order (the example lists five)
FEATURED_PRODUCT_IDS=1,2,3,4,5

# Email (Mailpit local catcher by default; web UI on http://localhost:8025)
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SALES_EMAIL=sales@example.com
